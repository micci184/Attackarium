[Unit]
Description=Attackarium HTTP capture collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=attackarium
Group=attackarium
ExecStart=/opt/attackarium/venv/bin/python /opt/attackarium/http-collector/collector.py
Restart=on-failure
RestartSec=5
Environment=HTTP_COLLECTOR_HOST=0.0.0.0
Environment=HTTP_COLLECTOR_PORT=80
Environment=HTTP_COLLECTOR_PROTOCOL=http
Environment=HTTP_COLLECTOR_REPORTED_PORT=80
Environment=HTTP_COLLECTOR_OUTPUT=/var/log/attackarium/http-collector.jsonl

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/log/attackarium
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
# Each connection uses two threads (worker + deadline timer): 32 slots need
# 66 tasks plus headroom for exiting threads.
TasksMax=128

[Install]
WantedBy=multi-user.target
