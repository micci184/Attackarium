# =============================================================================
# Attackarium — Environment Variables Example (PLACEHOLDERS ONLY)
# Never commit real keys, tokens, credentials, source IPs, or sensor endpoints.
# Copy to .env.local (for apps/web) or configure via Supabase/Vercel secrets.
# =============================================================================

# --- Public Web App (apps/web) ---
# Only anonymous/public read credentials belong in NEXT_PUBLIC_*.
# NEVER place SUPABASE_SERVICE_ROLE_KEY or ingest secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local development flag for synthetic/mock data fallback (no live DB required)
# Set to "false" when connected to Supabase public views.
USE_MOCK=true

# --- Supabase Server / Edge Functions (supabase/functions/ingest) ---
# Managed via Supabase secrets in hosted environments; local only for dev/tests.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose

# Per-sensor HMAC signing secrets (JSON map: {"sensor-id":"hex-or-base64-secret"})
# Rotate each sensor independently; never commit real secrets.
INGEST_SENSOR_SECRETS_JSON={"sensor-dev-01":"replace-with-32-byte-random-secret"}
INGEST_MAX_SKEW_SECONDS=300
INGEST_MAX_BODY_BYTES=262144
INGEST_MAX_BATCH_EVENTS=100
INGEST_RATE_LIMIT_PER_MINUTE=60

# Required (>=16 chars) salt for keyed HMAC hashing of source IPs.
# Ingest hashes the address and discards it. Plaintext src_ip is never stored.
IP_HASH_SALT=replace-with-32-byte-random-salt

# --- Sensor Shipper (sensors/shipper) — kept strictly on sensor host ---
SENSOR_ID=sensor-dev-01
SENSOR_HMAC_SECRET=replace-with-32-byte-random-secret
INGEST_ENDPOINT_URL=https://your-project-ref.supabase.co/functions/v1/ingest
SHIPPER_SPOOL_PATH=./spool/events.sqlite3
SHIPPER_SPOOL_MAX_BYTES=104857600

# --- Background Jobs (jobs/) — server-side only ---
# Daily KEV/EPSS sync (jobs/threat-intel/run.ts) uses SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY above. It stores the KEV catalog and EPSS scores
# for stored CVEs only. The full EPSS CSV is not imported.
NVD_API_KEY=optional-nvd-api-key
LLM_PROVIDER=openai
LLM_MODEL_ID=replace-with-model-id
LLM_API_KEY=replace-with-llm-api-key

# --- Remote MCP & Admin Security (Vercel server-side only; NEVER NEXT_PUBLIC_*) ---
# Comma-separated Supabase Auth user UUIDs permitted to access operator Admin Console/APIs
# Must be combined with mandatory MFA (aal2); never rely on DB is_admin flag alone.
ADMIN_ALLOWED_USER_IDS=replace-with-operator-supabase-user-uuid
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_REQUIRED_TERMS_VERSION=2026-11-21
SUPABASE_AUTH_ISSUER=https://your-project-ref.supabase.co/auth/v1

